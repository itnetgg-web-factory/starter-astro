---
// Page modèle : à compléter pour chaque client selon les données réellement collectées.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Politique de confidentialité | ${site.name}`} description={`Données personnelles traitées par le site ${site.name}, finalités, durées de conservation et droits.`}>
  <article class="container prose legal">
    <h1>Politique de confidentialité</h1>
    <h2>Données collectées</h2>
    <p>Ce site ne dépose aucun traceur publicitaire. Les seules données traitées sont celles que vous nous envoyez par e-mail.</p>
    <h2>Finalité et durée de conservation</h2>
    <p>Vos messages servent uniquement à répondre à votre demande. Durée de conservation : à compléter.</p>
    <h2>Vos droits</h2>
    <p>Vous pouvez demander l'accès, la rectification ou la suppression de vos données en écrivant à <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-5) 0;
  }
</style>
