---
// Pied de page : nom, liens légaux, mention de copyright.
import type { NavItem } from './Header.astro';

export interface Props {
  siteName: string;
  links: NavItem[];
  note?: string | undefined;
}

const { siteName, links, note } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {siteName}</p>
    {note && <p class="footer__note">{note}</p>}
    <nav aria-label="Liens du pied de page">
      <ul class="footer__links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
  }

  .footer p {
    margin: 0;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    color: var(--color-muted);
  }
</style>
