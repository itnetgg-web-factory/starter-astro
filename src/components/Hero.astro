---
// Présentation : titre principal (h1), accroche et appels à l'action.
import Button from './Button.astro';
import type { Props as ButtonProps } from './Button.astro';

export interface Props {
  title: string;
  lead: string;
  eyebrow?: string | undefined;
  actions?: ButtonProps[] | undefined;
}

const { title, lead, eyebrow, actions = [] } = Astro.props;
---

<section class="hero" aria-labelledby="hero-titre">
  <div class="container">
    {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
    <h1 id="hero-titre" class="hero__title">{title}</h1>
    <p class="hero__lead">{lead}</p>
    {
      actions.length > 0 && (
        <div class="hero__actions">
          {actions.map((action) => (
            <Button {...action} />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-5);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero__title {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(2rem, 1.4rem + 3vw, 3.25rem);
  }

  .hero__lead {
    max-width: 60ch;
    margin: var(--space-2) 0 0;
    font-size: 1.1875rem;
    color: var(--color-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
