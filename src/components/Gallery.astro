---
// Galerie d'images optimisées (formats modernes, tailles adaptées, chargement différé).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

export interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<ul class="gallery">
  {
    images.map((image) => (
      <li>
        <figure class="gallery__item">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw"
            loading="lazy"
            decoding="async"
          />
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    margin: 0;
  }

  .gallery__item img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .gallery__item figcaption {
    margin-top: var(--space-1);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
</style>
