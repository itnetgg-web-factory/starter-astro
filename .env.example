# Variables attendues par le projet. Copier en .env pour le développement local.
# Ne jamais mettre de vraie valeur secrète dans ce fichier.

# URL publique du site (SEO, liens absolus, sitemap)
PUBLIC_SITE_URL=http://localhost:4321

# Indexation par les moteurs : false en développement et en préproduction,
# true uniquement pour la production validée.
PUBLIC_SITE_INDEXABLE=false

# Déploiement Cloudflare : fournis par les secrets GitHub, jamais en local dans Git
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Decap CMS : l'authentification GitHub est assurée par le Worker du site (worker/oauth.js).
# Ses variables sont dans .dev.vars en local (voir .dev.vars.example) et dans les secrets du Worker.
