# Variables attendues par le projet. Copier en .env pour le développement local.
# Ne jamais mettre de vraie valeur secrète dans ce fichier.

# URL publique du site (utilisée pour le SEO et les liens absolus)
PUBLIC_SITE_URL=http://localhost:4321

# Déploiement Cloudflare : fournis par les secrets GitHub, jamais en local dans Git
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Decap CMS : authentification GitHub (solution OAuth à choisir au bloc Astro 3/4)
# DECAP_OAUTH_BASE_URL=
