// Worker du site : sert les fichiers construits (dist/) et l'authentification de Decap CMS.
// Seules les routes /oauth/* exécutent du code ; tout le reste est servi comme fichiers statiques.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-astro",
  "main": "worker/oauth.js",
  "compatibility_date": "2026-11-01",
  // Adresse <nom>.<sous-domaine>.workers.dev tant que le site n'est pas validé ; pas d'adresse par version.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/oauth/*"]
  },
  // Domaine autorisé à recevoir un jeton GitHub (Decap en ligne). En local, .dev.vars prend le relais.
  "vars": {
    "ALLOWED_DOMAINS": "starter-astro.itnetgg-web-factory-dev.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
